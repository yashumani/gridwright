{
  "name": "@gridwright/react",
  "version": "0.1.0",
  "description": "React renderer for Gridwright: <Dashboard>, grid layout and the cross-filter store.",
  "license": "MIT",
  "author": "yashumani (https://github.com/yashumani)",
  "homepage": "https://github.com/yashumani/gridwright#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yashumani/gridwright.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/yashumani/gridwright/issues",
  "keywords": [
    "react",
    "dashboard",
    "cross-filter",
    "components",
    "dashboard",
    "analytics",
    "declarative",
    "manifest",
    "gridwright"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@gridwright/schema": "workspace:*",
    "@gridwright/engine": "workspace:*",
    "@gridwright/panels": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
