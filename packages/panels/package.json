{
  "name": "@gridwright/panels",
  "version": "0.1.0",
  "description": "Chart components for Gridwright, each shipping a schema for its own props.",
  "license": "MIT",
  "author": "yashumani (https://github.com/yashumani)",
  "homepage": "https://github.com/yashumani/gridwright#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yashumani/gridwright.git",
    "directory": "packages/panels"
  },
  "bugs": "https://github.com/yashumani/gridwright/issues",
  "keywords": [
    "charts",
    "svg",
    "react",
    "kpi",
    "visualization",
    "dashboard",
    "analytics",
    "declarative",
    "manifest",
    "gridwright"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
